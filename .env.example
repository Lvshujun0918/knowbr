# 知行桥配置示例：Compose 自动读取根目录 .env；本地 go run 需 export，后端不自动加载 .env。

# 本地服务端口 / Compose 宿主机端口（容器内固定 8080）
ZXQ_PORT=8080

# Compose 构建时的 Go 依赖源（可按网络环境切换为 https://goproxy.cn,direct）
GOPROXY=https://proxy.golang.org,direct

# 本地 SQLite 路径（相对 server/）；Compose 固定为 /app/data/knowbr.db，并使用命名卷
ZXQ_DB_PATH=data/knowbr.db

# 本地前端产物目录；Compose 固定为 /app/web/dist
ZXQ_WEB_DIST=../web/dist

# 调试模式：true 时输出 Gin 调试日志
ZXQ_DEBUG=false

# ---------------------------------------------------------------------------
# 可选：大模型接入（OpenAI 兼容 Chat Completions 接口）
# 不配置 ZXQ_LLM_API_KEY 时应用自动使用内置规则模板模式，功能完整可用。
# 密钥只保存在服务端，禁止写入前端代码或公开仓库。
# ---------------------------------------------------------------------------
# ZXQ_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ZXQ_LLM_BASE_URL=https://api.openai.com/v1
# ZXQ_LLM_MODEL=gpt-4o-mini
# 单次调用超时（秒），超时后自动回退规则模式
# ZXQ_LLM_TIMEOUT_SECONDS=20
# 设为 true 可强制关闭大模型（即使配置了密钥）
# ZXQ_LLM_DISABLED=false
